{
  "name": "@minswap/sdk-v2",
  "version": "1.0.0",
  "description": "TypeScript SDK for the Minswap API: tokens, pools, aggregator swaps, farms, and MIN staking",
  "license": "MIT",
  "author": "Minswap Labs",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "minswap",
    "cardano",
    "dex",
    "aggregator",
    "sdk",
    "defi"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minswap/minswap-sdk-v2.git"
  },
  "homepage": "https://github.com/minswap/minswap-sdk-v2#readme",
  "bugs": {
    "url": "https://github.com/minswap/minswap-sdk-v2/issues"
  },
  "dependencies": {
    "json-bigint": "^1.0.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@minswap/internal-sdk": "^0.1.13"
  },
  "peerDependenciesMeta": {
    "@minswap/internal-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/json-bigint": "^1.0.4",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  },
  "scripts": {
    "build": "tsup",
    "smoke": "node scripts/smoke-build.mjs",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --write \"**/*.ts\"",
    "check-format": "prettier --check \"**/*.ts\"",
    "exec": "tsx"
  }
}
